# Django: generate a unique production value and configure it in the host's secret manager.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=false
CORS_ALLOWED_ORIGINS=https://app.example.com
DB_PASSWORD=replace-with-your-database-password

# OTP delivery remains disabled until an approved server-side SMS adapter is configured.
OTP_SMS_PROVIDER=disabled
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_PHONE_HOUR=5
OTP_MAX_REQUESTS_PER_IP_HOUR=20
